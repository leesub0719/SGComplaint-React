[Unit]
Description=SGComplaint local health monitor
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/sgcomplaint/sgcomplaint-monitor.sh
Environment=MONITOR_PORT=9081
StateDirectory=sgcomplaint-monitor
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true


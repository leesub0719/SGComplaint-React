# 같은 값을 계속 유지해야 서버 재시작 후 로그인 유지 쿠키가 유효합니다.
# 운영 서버에서 openssl rand -base64 48 로 생성한 충분히 긴 값을 사용하세요.
REMEMBER_ME_KEY=replace-with-a-random-fixed-value

# 자동 파기는 백업과 아래 사전 조회를 확인한 뒤 true로 변경합니다.
DATA_RETENTION_CLEANUP_ENABLED=false
WITHDRAWN_PERSONAL_RETENTION_DAYS=30
COMPLAINT_ATTACHMENT_RETENTION_DAYS=365
DATA_RETENTION_BATCH_SIZE=200
DATA_RETENTION_CLEANUP_CRON=0 30 3 * * *

